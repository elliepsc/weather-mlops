# Copier ce fichier en secrets.toml et remplir les valeurs.
# Sur Streamlit Community Cloud : coller le contenu dans App Settings → Secrets.
# En local : créer streamlit_app/.streamlit/secrets.toml (ignoré par git).

# URL de l'API FastAPI déployée sur Render (ou autre hôte).
# Laisser vide pour utiliser la valeur par défaut : http://localhost:8001
API_URL = "https://weather-mlops-api.onrender.com"
