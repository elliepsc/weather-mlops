FROM apache/airflow:3.0.0

# Install only the dependencies needed by DAG tasks. The API requirements pin
# newer FastAPI/Uvicorn versions, which are not compatible with Airflow 3.0.0.
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

# Pipeline code is mounted as a volume at runtime (see docker-compose.yaml).
# PYTHONPATH=/opt/airflow allows imports such as pipeline.xxx from DAGs.
