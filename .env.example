# Copy to .env and adjust as needed.
#
# Secrets and environment-specific values live here.
# Business thresholds and MLOps policy live in config/mlops.yaml.

# Environment
ENV=dev

# Database
# Relative paths are resolved from the repository root.
DB_PATH=data/weather.db

# Open-Meteo
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Monitoring alerting
SLACK_WEBHOOK_URL=
ALERT_EMAIL=destinataire@example.com

# API
API_HOST=0.0.0.0
API_PORT=8001        # Local direct (python api/app.py). Docker uses 8000 (set in docker-compose).
                     # 8083 is reserved for Airflow UI — do not use it here.

# Airflow UI bootstrap
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=weather

# MLflow
# Leave commented to use the local default selected by pipeline/mlflow_config.py.
# MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db

AIRFLOW_PORT=8083    # Airflow UI stays on 8083 (docker-compose: 8083→8080)

GH_TOKEN=  # GitHub Personal Access Token (scope: repo ou contents:write) + variable Airflow GH_TOKEN (Admin → Variables) in order for weather_dbt_analytics DAG to push mart_*.csv to GitHub after each Power BI export.

# MLflow JSON export
# Set to true if train_dag does NOT trigger dbt_dag (which already handles git push).
AUTO_COMMIT_MLFLOW_JSON=false

# ── GCP / BigQuery / GCS (Phase 2 migration) ────────────────────────────────
GCP_PROJECT_ID=           # ex: my-gcp-project-123
GCP_DATASET=weather_mlops
GCP_LOCATION=EU
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON (CI/CD only — local uses oauth)

# dbt BigQuery method: oauth (local, needs: gcloud auth application-default login)
#                       service-account (CI/CD, needs GOOGLE_APPLICATION_CREDENTIALS)
DBT_BIGQUERY_METHOD=oauth

GCS_BUCKET=               # ex: my-bucket-weather-mlops
GCS_ENABLED=false         # set to true to activate GCS Parquet export in dbt DAG
