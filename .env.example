# Copy to .env and adjust as needed.
#
# Secrets and environment-specific values live here.
# Business thresholds and MLOps policy live in config/mlops.yaml.

# Environment
ENV=dev

# Database
# Relative paths are resolved from the repository root.
DB_PATH=data/weather.db

# Open-Meteo
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Monitoring alerting
SLACK_WEBHOOK_URL=

# API
API_HOST=0.0.0.0
API_PORT=8083

# Airflow UI bootstrap
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=weather

# MLflow
# Leave commented to use the local default selected by pipeline/mlflow_config.py.
# MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
