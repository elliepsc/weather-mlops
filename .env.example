# ── Copier ce fichier en .env et remplir les valeurs ─────────────────────────
# cp .env.example .env

# ── MLflow ────────────────────────────────────────────────────────────────────
# Laisse cette variable commentée pour utiliser le fallback automatique :
# - Windows / Docker : <repo>/mlflow/mlflow.db
# - WSL + repo sous /mnt/... : ~/.weather-rain/mlflow/mlflow.db
# Décommente seulement pour forcer un backend spécifique.
# MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db

# ── API FastAPI ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── Airflow ───────────────────────────────────────────────────────────────────
# Mot de passe de l'admin Airflow (UI sur localhost:8083 si Airflow lancé)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=weather

# ── Open-Meteo ────────────────────────────────────────────────────────────────
# API gratuite, aucune clé requise.
# Si tu passes sur la version commerciale (plus de requêtes/jour), ajoute ici :
# OPEN_METEO_API_KEY=

# ── Alertes (optionnel — pour monitoring_dag email alert) ─────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ton_email@gmail.com
# SMTP_PASSWORD=ton_app_password
# ALERT_EMAIL=destinataire@example.com
