FROM apache/airflow:3.0.0

# Installe les dépendances du projet dans l'image Airflow
# (xgboost, scipy, mlflow, etc. ne sont pas dans l'image de base)
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Le code pipeline est monté en volume au runtime (voir docker-compose.yaml)
# PYTHONPATH=/opt/airflow permet d'importer pipeline.xxx depuis les DAGs
