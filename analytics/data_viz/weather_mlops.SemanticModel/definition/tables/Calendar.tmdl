	column 'Saison Ordre'
		formatString: 0
		lineageTag: c5afd125-f0e1-4e7c-a0d3-8fc33b14f4e4
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Saison Ordre]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Année", YEAR ( [Date] ),
				    "Mois Num", MONTH ( [Date] ),
				    "Mois", FORMAT ( [Date], "mmmm" ),
				    "Mois Court", FORMAT ( [Date], "mmm" ),
				    "Année-Mois", FORMAT ( [Date], "yyyy-MM" ),
				    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				    "Jour", DAY ( [Date] ),
				    "Jour semaine Num", WEEKDAY ( [Date], 2 ),
				    "Jour semaine", FORMAT ( [Date], "dddd" ),
				    "Semaine", WEEKNUM ( [Date], 2 ),
				    "Semaine ISO", "W" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				    "Année ISO", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				    "Année-Semaine ISO",
				        VAR ISOYear = YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 )
				        VAR ISOWeek = WEEKNUM ( [Date], 21 )
				        RETURN ISOYear & "-W" & FORMAT ( ISOWeek, "00" ),
				    "Saison",
				        SWITCH(
				            MONTH ( [Date] ),
				            12, "Summer", 1, "Summer", 2, "Summer",
				            3, "Autumn",  4, "Autumn",  5, "Autumn",
				            6, "Winter",  7, "Winter",  8, "Winter",
				            "Spring"
				        ),
				    "Saison Ordre",
				        SWITCH(
				            MONTH ( [Date] ),
				            12, 1, 1, 1, 2, 1,
				            3, 2, 4, 2, 5, 2,
				            6, 3, 7, 3, 8, 3,
				            4
				        )
				)
				
				```

	annotation PBI_Id = 88db8abba57d4d8cb57b2efbad0314d3

