# ── Environnements virtuels ──────────────────────────────────────────────────
venv/
env/
.venv/
airflow_env/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb~
Ingestion.ipynb

# ── Données générées (ne pas versionner les gros fichiers) ───────────────────
data/weather.db
data/analytics.duckdb
data/analytics/
# Seuls les 5 exports Power BI sont trackés (poussés automatiquement par le DAG)
!data/analytics/mart_forecast_vs_actual_timeline.csv
!data/analytics/mart_model_performance_overview.csv
!data/analytics/mart_model_performance_by_city.csv
!data/analytics/mart_mlops_health.csv
!data/analytics/mart_retraining_history.csv
data/output/
data/raw/weatherAUS.csv
data/processed/
data/monitoring/
data/production_logs/
data/raw.dvc

# ── Demo data (DEMO_MODE) ─────────────────────────────────────────────────────
# Le répertoire demo/ est ignoré sauf les deux bases générées par generate_demo_dataset.py.
# Ces fichiers sont committés pour que Render les trouve au build sans recalcul.
data/demo/
!data/demo/*.db
!data/demo/*.duckdb


# ── Modèles ML (générés par le pipeline) ─────────────────────────────────────
# models/mlflow_latest.json is intentionally tracked — API fallback on Render.
/models/*.pkl
/models/metrics.json
/models/baseline/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── MLflow (artefacts lourds) ─────────────────────────────────────────────────
mlflow/mlartifacts/
mlflow/mlruns/
mlflow.db
mlruns/

# ── DVC (ancien système) ──────────────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/

# ── Secrets & config locaux ───────────────────────────────────────────────────
.env
.claude/
*.secret
*.key

# Streamlit secrets (le .example est tracké, pas le vrai fichier)
streamlit_app/.streamlit/secrets.toml

# ── Docker volumes ────────────────────────────────────────────────────────────
grafana_data/

# ── DVC (résidus) ─────────────────────────────────────────────────────────────
.dvc/
.dvcignore
*.dvc

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Autres ───────────────────────────────────────────────────────────────────
config/simple_auth_manager_passwords.json
/weather-mlops

# ── Dbt ───────────────────────────────────────────────────────────────────
analytics/target/
analytics/dbt_packages/
analytics/logs/
analytics/*.duckdb
analytics/profiles.yml
